# -*- mode: ruby -*-
# vi: set ft=ruby :

ENV_FILE = File.expand_path("../.env", __dir__)
abort("ERROR: .env file not found! Run 'cp .env.example .env' in the repo root first.") unless File.exist?(ENV_FILE)

File.readlines("../.env").each do |line|
  line = line.strip
  next if line.empty? || line.start_with?("#")
  key, value = line.split("=", 2)
  ENV[key] = value.gsub(/\A['"]|['"]\z/, "") if key && value
end

def provision_ansible_access(vm)
  vm.vm.provision "file",
    source: "./ssh-keys/ansible_key.pub",
    destination: "/tmp/ansible_key.pub"

  vm.vm.provision "shell", inline: <<-SHELL
    mkdir -p /home/vagrant/.ssh
    touch /home/vagrant/.ssh/authorized_keys
    
    grep -qxF "$(cat /tmp/ansible_key.pub)" /home/vagrant/.ssh/authorized_keys || \
      cat /tmp/ansible_key.pub >> /home/vagrant/.ssh/authorized_keys

    chown -R vagrant:vagrant /home/vagrant/.ssh
    chmod 700 /home/vagrant/.ssh
    chmod 600 /home/vagrant/.ssh/authorized_keys

    rm -f /tmp/ansible_key.pub
  SHELL
end

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  config.vm.synced_folder ".", "/vagrant", disabled: true
  config.vm.provision "shell", path: "scripts/init_firewall.sh"
  config.vm.provision "shell", path: "scripts/configure_ssh.sh",env: { "SSH_PUB_KEY" => ENV["SSH_PUB_KEY"] }

  config.vm.boot_timeout = 600

  # 1. CI-CD (Ansible Control Node & Jenkins)
  config.vm.define "CI-CD" do |app|
    app.vm.hostname = "ci-cd"
    app.vm.network "private_network", ip: "192.168.56.6"
    app.vm.network "forwarded_port",
      guest: 8080,
      host: 8081,
      host_ip: "127.0.0.1"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-CI-CD"
      vb.cpus = 4
      vb.memory = 4096
      vb.linked_clone = true
    end
    # Provision private SSH key and .env for Ansible and Jenkins
    app.vm.provision "file",
      source: "./ssh-keys/ansible_key",
      destination: "/tmp/ansible_key"
    app.vm.provision "file",
      source: "../.env",
      destination: "/tmp/.env"
    app.vm.provision "shell", path: "scripts/init_cicd.sh"
    app.vm.provision "shell", inline: <<-SHELL
      mkdir -p /home/vagrant/.ssh
      cp /tmp/ansible_key /home/vagrant/.ssh/ansible_key
      chown vagrant:vagrant /home/vagrant/.ssh/ansible_key
      chmod 600 /home/vagrant/.ssh/ansible_key

      mkdir -p /var/lib/jenkins/.ssh /var/lib/jenkins/secrets
      cp /tmp/ansible_key /var/lib/jenkins/.ssh/ansible_key
      cp /tmp/.env /var/lib/jenkins/secrets/.env
      chown -R jenkins:jenkins /var/lib/jenkins/.ssh /var/lib/jenkins/secrets
      chmod 700 /var/lib/jenkins/.ssh
      chmod 600 /var/lib/jenkins/.ssh/ansible_key /var/lib/jenkins/secrets/.env

      rm -f /tmp/ansible_key /tmp/.env
    SHELL
    app.vm.provision "file",
      source: "./ansible",
      destination: "/home/vagrant/ansible"
    app.vm.provision "file",
      source: "./jenkins",
      destination: "/home/vagrant/jenkins"
  end

  # 2. Consul Server (Configured via Ansible role)
  config.vm.define "Consul" do |app|
    app.vm.hostname = "consul"
    app.vm.network "private_network", ip: "192.168.56.5"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-Consul"
      vb.cpus = 1
      vb.memory = 512
      vb.linked_clone = true
    end
    provision_ansible_access(app)
  end

  # 3. Database Server
  config.vm.define "DB" do |app|
    app.vm.hostname = "db"
    app.vm.network "private_network", ip: "192.168.56.4"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-DB"
      vb.cpus = 1
      vb.memory = 1024
      vb.linked_clone = true
    end
    provision_ansible_access(app)

    app.vm.provision "file",
      source: "../.env",
      destination: "/tmp/.env"

    app.vm.provision "file",
      source: "consul/service-db.json",
      destination: "/tmp/service-db.json"

    app.vm.provision "shell", path: "scripts/install_consul_client.sh"
    app.vm.provision "shell", path: "scripts/init_db.sh"
  end

  # 4. Application Servers
  config.vm.define "app1" do |app|
    app.vm.hostname = "app1"
    app.vm.network "private_network", ip: "192.168.56.2"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-app1"
      vb.cpus = 1
      vb.memory = 1024
      vb.linked_clone = true
    end
    provision_ansible_access(app)

    app.vm.provision "file",
      source: "consul/service-web.json",
      destination: "/tmp/service-web.json"

    app.vm.provision "shell", path: "scripts/install_consul_client.sh"
    app.vm.provision "shell", path: "scripts/configure_consul_resolver.sh"
    app.vm.provision "shell", path: "scripts/setup_nfs_client.sh"
  end

  config.vm.define "app2" do |app|
    app.vm.hostname = "app2"
    app.vm.network "private_network", ip: "192.168.56.3"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-app2"
      vb.cpus = 1
      vb.memory = 1024
      vb.linked_clone = true
    end
    provision_ansible_access(app)

    app.vm.provision "file",
      source: "../web/",
      destination: "/tmp/web"

    app.vm.provision "file",
      source: "../.env",
      destination: "/tmp/.env"

    app.vm.provision "file",
      source: "consul/service-web.json",
      destination: "/tmp/service-web.json"

    app.vm.provision "shell", path: "scripts/install_consul_client.sh"
    app.vm.provision "shell", path: "scripts/configure_consul_resolver.sh"
    app.vm.provision "shell", path: "scripts/setup_nfs_client.sh"
  end

  # 5. Load Balancer & NFS Server
  config.vm.define "LB" do |app|
    app.vm.hostname = "lb"
    app.vm.network "private_network", ip: "192.168.56.10"

    app.vm.network "forwarded_port",
      guest: 80,
      host: 8080,
      host_ip: "127.0.0.1"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-LB"
      vb.cpus = 1
      vb.memory = 512
      vb.linked_clone = true
    end
    provision_ansible_access(app)

    app.vm.provision "file",
      source: "consul/nginx.conf.ctmpl",
      destination: "/tmp/nginx.conf.ctmpl"

    app.vm.provision "file",
      source: "consul/service-lb.json",
      destination: "/tmp/services.json"

    app.vm.provision "shell", path: "scripts/install_consul_client.sh"
    app.vm.provision "shell", path: "scripts/init_nginx_lb.sh"
    app.vm.provision "shell", path: "scripts/setup_nfs_server.sh"
  end

  # uncomment for prod (removing vagrant user)
  # config.vm.provision "shell", path: "scripts/cleanup_vagrant.sh"
end