# -*- mode: ruby -*-
# vi: set ft=ruby :
if File.exist?("../.env")
  File.readlines("../.env").each do |line|
    line = line.strip
    next if line.empty? || line.start_with?("#")
    key, value = line.split("=", 2)
    ENV[key] = value.gsub(/\A['"]|['"]\z/, "") if key && value
  end
end

Vagrant.configure("2") do |config|
  config.vm.box = "ubuntu/jammy64"

  config.ssh.insert_key = false
  config.vm.synced_folder ".", "/vagrant", disabled: true

  config.ssh.insert_key = true
  config.vm.provision "shell", path: "scripts/configure_ssh.sh",env: { "SSH_PUB_KEY" => ENV["SSH_PUB_KEY"] }

  config.vm.define "DB" do |app|
    app.vm.hostname = "db"
    app.vm.network "private_network", ip: "192.168.56.4"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-DB"
      vb.cpus = 1
      vb.memory = 1024
      vb.linked_clone = true
    end

    app.vm.provision "shell", path: "scripts/init_firewall.sh"
    app.vm.provision "shell", path: "scripts/init_db.sh"
  end

  config.vm.define "Consul" do |app|
    app.vm.hostname = "consul"
    app.vm.network "private_network", ip: "192.168.56.5"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-Consul"
      vb.cpus = 1
      vb.memory = 512
      vb.linked_clone = true
    end

    app.vm.provision "file",
      source: "consul/consul.hcl",
      destination: "/tmp/consul.hcl"

    app.vm.provision "shell", path: "consul/install.sh"
  end

  config.vm.define "app1" do |app|
    app.vm.hostname = "app1"
    app.vm.network "private_network", ip: "192.168.56.2"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-app1"
      vb.cpus = 1
      vb.memory = 512
      vb.linked_clone = true
    end

    app.vm.provision "file",
      source: "../web/",
      destination: "/tmp/web"

    app.vm.provision "shell", path: "scripts/init_firewall.sh"
    app.vm.provision "shell", path: "scripts/init_web.sh"
  end

  config.vm.define "app2" do |app|
    app.vm.hostname = "app2"
    app.vm.network "private_network", ip: "192.168.56.3"

    app.vm.provider "virtualbox" do |vb|
      vb.name = "Vagrant-app2"
      vb.cpus = 1
      vb.memory = 512
      vb.linked_clone = true
    end

    app.vm.provision "file",
      source: "../web/",
      destination: "/tmp/web"

    app.vm.provision "shell", path: "scripts/init_firewall.sh"
    app.vm.provision "shell", path: "scripts/init_web.sh"
  end

  config.vm.define "LB" do |app|
      app.vm.hostname = "lb"
      app.vm.network "private_network", ip: "192.168.56.10"

      app.vm.network "forwarded_port",
        guest: 80,
        host: 8080,
        host_ip: "127.0.0.1"

      app.vm.provider "virtualbox" do |vb|
        vb.name = "Vagrant-LB"
        vb.cpus = 1
        vb.memory = 512
        vb.linked_clone = true
      end

      app.vm.provision "shell", path: "scripts/init_firewall.sh"
      app.vm.provision "shell", path: "scripts/init_nginx_lb.sh"
      end
end