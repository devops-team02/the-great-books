upstream the-great-books {
        {% for host in groups['application_servers'] %}
                server {{ hostvars[host]['ansible_host'] }}:{{nginx_backend_port}} max_fails={{ nginx_max_fails }} fail_timeout={{ nginx_fail_timeout }};
        {% endfor %}
}

server {
        listen {{ nginx_listen_port }} default_server;
        server_name _;

        location / {
                proxy_pass http://the-great-books;
                proxy_set_header Host $host;
                proxy_set_header X-Real-IP $remote_addr;
                proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
                proxy_set_header X-Forwarded-Proto $scheme;

                proxy_connect_timeout {{ nginx_proxy_connect_timeout }};
                proxy_read_timeout {{ nginx_proxy_read_timeout }};
    }
}