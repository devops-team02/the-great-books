pipeline {
    agent any

    environment {
        ANSIBLE_FORCE_COLOR = 'true'
        ANSIBLE_HOST_KEY_CHECKING = 'False'
        ENV_FILE = '/var/lib/jenkins/secrets/.env'
        ANSIBLE_KEY = '/var/lib/jenkins/.ssh/ansible_key'
    }

    stages {
        stage('Checkout') {
            steps {
                checkout scm
            }
        }

        stage('Deploy') {
            steps {
                sh '''
                    cd infrastructure/ansible
                    ansible-playbook site.yml \
                        -i inventory/hosts.yml \
                        -e "env_file_path=${ENV_FILE}" \
                        --private-key "${ANSIBLE_KEY}" \
                        -v
                '''
            }
        }

    }

    post {
        success {
            echo '  Deploy Pipeline Finished Successfully!'
        }
        failure {
            echo '  Deploy Pipeline Failed! Check logs above.'
        }
        always {
            cleanWs cleanWhenFailure: false,
                    cleanWhenUnstable: false,
                    cleanWhenAborted: false,
                    deleteDirs: true
        }
    }
}
